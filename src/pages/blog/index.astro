---
import BaseLayout from '../../layouts/BaseLayout.astro';

// BASE_URL es '/' en local y '/nombre-repo/' al publicar en GitHub Pages.
const base = import.meta.env.BASE_URL;

// Índice automático del blog: añade un objeto por cada artículo.
// Si cambias el título de un artículo, actualízalo también aquí.
// Las rutas se escriben sin la barra inicial: se les añade BASE_URL al renderizar.
const articulos = [
  {
    title: 'Cómo crear tu primera página web con Astro',
    href: 'blog/articulo-1/',
    description: 'Guía práctica para instalar Astro y publicar tu primera página web.',
  },
  {
    title: 'Optimiza el rendimiento de tu sitio estático',
    href: 'blog/articulo-2/',
    description:
      'Consejos para hacer tu sitio más rápido y mejorar su posicionamiento en buscadores.',
  },
];
---

<BaseLayout
  title="Blog | Nimbus Studio"
  description="Blog de Nimbus Studio: tutoriales, consejos y novedades sobre diseño y desarrollo web."
>
  <h1>Blog</h1>

  <ul class="blog-index">
    {articulos.map((articulo) => (
      <li>
        <a href={`${base}${articulo.href}`}>{articulo.title}</a>
        <p>{articulo.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
