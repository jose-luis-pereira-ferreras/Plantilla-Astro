---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Optimiza el rendimiento de tu sitio estático | Nimbus Studio"
  description="Consejos prácticos para hacer tu sitio web más rápido y mejorar su posicionamiento en buscadores."
>
  <article class="articulo">
    <h1>Optimiza el rendimiento de tu sitio estático</h1>
    <p>
      Mejora la velocidad de carga de tu sitio con Astro usando imágenes optimizadas
      y caché.
    </p>

    <h2>Medir el rendimiento</h2>
    <p>
      Usa herramientas como Lighthouse y PageSpeed Insights para identificar oportunidades
      de mejora de tu página.
    </p>

    <p><a href={`${base}blog/`}>Volver al blog</a></p>
  </article>
</BaseLayout>
